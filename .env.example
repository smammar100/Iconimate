# Iconimate — environment template. Copy to .env.local and fill in.
# .env.local is gitignored via the `.env*` rule. This file holds placeholders only.

# ── PostHog (optional) ───────────────────────────────────────────────────────
#
# Analytics and browser error tracking. BOTH must be set or the SDK never
# initialises and every capture is a no-op — see instrumentation-client.ts. That
# is deliberate: the gallery and copy buttons are static, so an unconfigured or
# unreachable PostHog degrades to silence rather than to a broken page.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at build time, so the project
# token here must be the WRITE-ONLY public key from Project Settings, never a
# personal API key.
# Either name works. PROJECT_TOKEN is what the original integration used and may
# already be set in Vercel; KEY is PostHog's own documented name. Set one.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Region-specific: https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Sanity ───────────────────────────────────────────────────────────────────
#
# Project + dataset are public by design; a projectId is not a secret. Access is
# governed by dataset visibility and tokens.
NEXT_PUBLIC_SANITY_PROJECT_ID=0gny1aq3
NEXT_PUBLIC_SANITY_DATASET=production
# Sanity's API is date-versioned; pinning stops a future change altering queries.
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Write token (Editor). Unprefixed on purpose — grants write access to the
# production dataset and must never reach the browser. Used only by
# scripts/import-to-sanity.mjs and scripts/generate-ai-prompts.mjs.
# Issue at https://www.sanity.io/manage/project/0gny1aq3/api#tokens
SANITY_IMPORT_TOKEN=
